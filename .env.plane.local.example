# Plane self-host / cloud connection for AutoLens AI.
# Copy to .env.plane.local and fill secrets locally. Do not commit .env.plane.local.
PLANE_BASE_URL=http://localhost:8080
PLANE_WORKSPACE=enes-workspace
PLANE_API_KEY=personal-access-token

# Optional: leave empty to let scripts/import_project_to_plane.py create/reuse the project by name.
# PLANE_PROJECT_ID=
PLANE_PROJECT_NAME=autolens-ai
PLANE_PROJECT_IDENTIFIER=AUTO
